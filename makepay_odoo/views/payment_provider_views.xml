<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="payment_provider_form_makepay" model="ir.ui.view">
    <field name="name">payment.provider.form.makepay</field>
    <field name="model">payment.provider</field>
    <field name="inherit_id" ref="payment.payment_provider_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='provider_credentials']" position="inside">
        <group invisible="code != 'makepay'">
          <field name="makepay_key_id"/>
          <field name="makepay_key_secret" password="True"/>
          <field name="makepay_webhook_secret" password="True"/>
          <field name="makepay_base_url"/>
          <field name="makepay_send_payment_request_email"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
